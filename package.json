    "@fastify/swagger-ui": "6.1.2",
    "@supabase/supabase-js": "^2.57.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "luxon": "^3.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@fastify/swagger-ui/static/**"
    }
  },
  "rewrites": [
    { "source": "/:path*", "destination": "/api/index?__afi_path=/:path*" }
  ]
}

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_MONTHLY_BUDGET_USD=5
AI_DEFAULT_MONTHLY_REQUEST_LIMIT=100
AI_MAX_INPUT_TOKENS=2000
AI_MAX_OUTPUT_TOKENS=300
AI_TOKEN_PARAMETER=max_completion_tokens
# Configure actual model prices; AI fails closed until configured.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
# Recovery codes: private persistent storage, never copied to the frontend.
RECOVERY_DATABASE_PATH=.data/password-recovery.sqlite
